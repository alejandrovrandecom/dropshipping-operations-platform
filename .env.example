# Copy to `.env.local` and fill with values printed by `pnpm db:setup`.
# This file holds placeholders only. Never put real secrets here.

# Local Supabase API URL (default from supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local publishable/anon key. Read it from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>

# Application base URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only privileged key. Never expose it to the browser, never commit it.
# Leave empty here; set it only in an ignored `.env.local` or a secret manager.
SUPABASE_SERVICE_ROLE_KEY=

# Direct local Postgres connection used by database tooling only.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
