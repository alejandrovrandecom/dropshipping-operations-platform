{
  "name": "control-base",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "db:setup": "bash scripts/db-setup.sh",
    "db:start": "npx --yes supabase start",
    "db:stop": "npx --yes supabase stop",
    "db:reset": "bash scripts/db-reset.sh",
    "db:smoke": "bash scripts/db-smoke.sh",
    "db:types": "printf '%s\\n' \"$(npx --yes supabase gen types typescript --local --schema public)\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "pg": "^8.16.3",
    "vitest": "^3.2.4"
  }
}
